# Server-side only. Never prefix these with VITE_.
# For local dev copy this file to .env.local and fill it in; on Vercel set them as Environment Variables.

# Apps Script web app URL (ends with /exec) and the API_KEY Script Property value
APPS_SCRIPT_URL=
APPS_SCRIPT_KEY=

# Optional soft gate (shared code); leave empty to make the leaderboard open
ACCESS_CODE=
